 func (m Mercure) ServeHTTP(w http.ResponseWriter, r *http.Request, next caddyhttp.Handler) error {
+	if r.URL.Path == "/metrics" {
+		// Tender Platform (локальный патч): в v0.16 метрики mercure_* уже
+		// собираются в prometheus.DefaultRegisterer (metrics.go), но Caddy-модуль
+		// не регистрирует HTTP-роут /metrics (Register() deprecated) → в
+		// официальном образе /metrics отдаёт 404. Отдаём рендер реестра здесь,
+		// чтобы Prometheus мог скрейпить хаб (см. docker/prometheus/prometheus.yml).
+		if registry, ok := prometheus.DefaultRegisterer.(*prometheus.Registry); ok {
+			promhttp.HandlerFor(registry, promhttp.HandlerOpts{}).ServeHTTP(w, r)
+		}
+
+		return nil
+	}
+
 	if !strings.HasPrefix(r.URL.Path, defaultHubURL) {
 		return next.ServeHTTP(w, r) //nolint:wrapcheck
 	}
