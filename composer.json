{
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-redis": "*",
        "ext-sodium": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "lcobucci/jwt": "^5.6",
        "openspout/openspout": "^5.10",
        "opis/json-schema": "^2",
        "symfony/amqp-messenger": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "^2",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/lock": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/mercure": "^0.7.2",
        "symfony/messenger": "8.1.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/password-hasher": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/redis-messenger": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/security-core": "8.1.*",
        "symfony/security-http": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/workflow": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "process-timeout": 1800
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "lint": [
            "php -l src",
            "php -l tests"
        ],
        "schema:check": "php scripts/check-event-schemas.php .",
        "phpstan": "phpstan analyse --no-progress",
        "cs-fixer": "php-cs-fixer fix --diff",
        "cs-fixer:check": "php-cs-fixer fix --dry-run --diff",
        "arkitect": "phparkitect check",
        "test:prepare": [
            "php bin/console doctrine:database:drop --force --if-exists --env=test",
            "php bin/console doctrine:database:create --env=test",
            "php bin/console doctrine:migrations:migrate --no-interaction --env=test",
            "php bin/console app:test:redis-cleanup --env=test"
        ],
        "test": "composer test:prepare && phpunit",
        "test:parallel": "bash scripts/test-parallel-prepare.sh",
        "test:smoke": "composer test:prepare && phpunit --group=smoke",
        "test:coverage": "bash scripts/test-coverage.sh",
        "test:parallel:full": [
            "@test:parallel",
            "@test:smoke"
        ],
        "test:coverage:check": "php scripts/check-coverage.php var/coverage/clover.xml",
        "test:unit": "phpunit tests/Unit",
        "quality": [
            "@lint",
            "@cs-fixer:check",
            "@phpstan",
            "@arkitect",
            "@test"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "brianium/paratest": "^7.24",
        "dama/doctrine-test-bundle": "^8.6",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "league/commonmark": "^2",
        "phparkitect/phparkitect": "^1.3",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.3",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "zenstruck/foundry": "^2.11"
    }
}
