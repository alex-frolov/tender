###> Tender Platform — production env template ###
# Скопировать в .env.prod (gitignored) и заполнить реальные секреты:
#   cp .env.prod.dist .env.prod && $EDITOR .env.prod
# Все значения подставляются в docker-compose.prod.yml (${VAR}) и в контейнеры.
# В прод-контейнеры попадают ТОЛЬКО переменные из этого файла + контракт
# services.yaml/.env.dist. Никаких секретов в git.
###< Tender Platform — production env template ###

# Публичные URL приложения (для ссылок в письмах и Mercure-публикаций)
DEFAULT_URI=https://tender.example.com
MAILER_FROM=no-reply@tender.example.com
EMAIL_VERIFY_URL_TEMPLATE=https://tender.example.com/verify-email?token=%s
PASSWORD_RESET_URL_TEMPLATE=https://tender.example.com/reset-password?token=%s
INVITE_URL_TEMPLATE=https://tender.example.com/invite
MERCURE_PUBLIC_URL=https://tender.example.com/.well-known/mercure

# Порты наружу (docker compose)
HTTP_PORT=8080
MERCURE_PORT=3008

# Инфраструктура (должны совпадать с секретами сервисов ниже)
POSTGRES_USER=tender
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tender
RABBITMQ_USER=tender
RABBITMQ_PASSWORD=change-me

# Symfony / секреты (обязательны)
APP_SECRET=change-me-64-hex
AUTH_JWT_SECRET=change-me-64-hex
ENCRYPTION_KEY=change-me-encryption-key-0123456789abcdef0123456789abcdef
MERCURE_JWT_SECRET_PUBLISH=change-me-publisher-key-32-chars-minimum!
MERCURE_JWT_SECRET_SUBSCRIBE=change-me-subscriber-key-32-chars-minimum!
MAILER_DSN=smtp://user:pass@smtp.example.com:587

# Mercure hub
MERCURE_SERVER_NAME=:80
MERCURE_CORS_ORIGINS=*

# Тюнинг (опционально; значения по умолчанию — из .env.dist)
DOMAIN_TIMEZONE=Europe/Moscow
RATE_LIMIT_GLOBAL_PER_MIN=600
# Плагин ru-state-procurement: 1 — доменные правила РФ активны
# (по умолчанию), 0 — дефолты ядра. Конфиг правил — config/ru_state_procurement.yaml.
PROCUREMENT_PLUGIN_ENABLED=1

# Версия сборки для app_build_info{version} (деплой-аннотации)
APP_VERSION=dev
