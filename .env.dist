###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=dev-secret-change-me
APP_SHARE_DIR=var/share
# Максимальный размер файла документа (байт; 20 МБ)
DOCUMENT_MAX_FILE_BYTES=20971520
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://tender:tender@db:5432/tender?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=no-reply@tender-platform.local
###< symfony/mailer ###

###> symfony/messenger ###
# RabbitMQ (amqp ext) — основной транспорт событий
MESSENGER_TRANSPORT_DSN=amqp://tender:tender@rabbitmq:5672/%2Ftender
# Redis-транспорт (альтернатива/для live-очередей)
MESSENGER_REDIS_DSN=redis://redis:6379/messages
# Выделенный канал почты (отдельная очередь tender_emails)
MESSENGER_EMAILS_DSN=amqp://tender:tender@rabbitmq:5672/%2Ftender
# Doctrine-транспорт (fallback / outbox)
MESSENGER_DOCTRINE_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mercure ###
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3008/.well-known/mercure
MERCURE_PUBLISH_URL=http://mercure/.well-known/mercure
MERCURE_JWT_SECRET_PUBLISH='!ChangeMePublisherKey!change-me-32-char-minimum'
MERCURE_JWT_SECRET_SUBSCRIBE='!ChangeMeSubscriberKey!change-me-32-char-minimum'
MERCURE_SUBSCRIBE_TTL=3600
###< symfony/mercure ###

###> redis ###
REDIS_URL=redis://redis:6379
###< redis ###

###> доменный часовой пояс ###
DOMAIN_TIMEZONE=Europe/Moscow
###< доменный часовой пояс ###
###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###
RABBITMQ_URL=amqp://tender:***@rabbitmq:5672/%2Ftender

###> security ###
AUTH_JWT_SECRET='change-me-64-hex'
AUTH_ACCESS_TTL=900
AUTH_REFRESH_TTL=2592000
# ключ шифрования содержимого заявок до вскрытия
ENCRYPTION_KEY='change-me-encryption-key-0123456789abcdef0123456789abcdef'
###< security ###

###> email verification ###
# TTL токена подтверждения email (сек)
EMAIL_VERIFY_TTL=3600
# Шаблон ссылки подтверждения в письме (%s — токен)
EMAIL_VERIFY_URL_TEMPLATE=https://app.tender-platform.local/verify-email?token=%s
###< email verification ###

###> password reset ###
# TTL токена восстановления пароля (сек)
PASSWORD_RESET_TTL=1800
# Шаблон ссылки сброса пароля в письме (%s — токен)
PASSWORD_RESET_URL_TEMPLATE=https://app.tender-platform.local/reset-password?token=%s
###< password reset ###

###> user invite ###
INVITE_URL_TEMPLATE=https://app.tender-platform.local/invite
###< user invite ###

###> idempotency ###
IDEMPOTENCY_TTL=3600
###< idempotency ###

###> auction recovery ###
AUCTION_HEARTBEAT_TIMEOUT=300
###< auction recovery ###

###> webhooks ###
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_DELIVERY_TIMEOUT=10
###< webhooks ###

###> notifications ###
NOTIFICATION_DIGEST_INTERVAL=86400
###< notifications ###
RATE_LIMIT_GLOBAL_PER_MIN=600

###> ru-state-procurement plugin ###
# Feature-flag доменных правил РФ (44-ФЗ/223-ФЗ): 1 — правила плагина активны
# (TimelineRules/AuctionRules/SecurityRules → ru-state-procurement), 0 — дефолты
# ядра. Конфигурация правил — config/ru_state_procurement.yaml (внешние данные).
PROCUREMENT_PLUGIN_ENABLED=1
###< ru-state-procurement plugin ###
