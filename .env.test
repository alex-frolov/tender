# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
###> security (тестовые) ###
AUTH_JWT_SECRET='test-secret-key-0123456789abcdef0123456789abcdef0123456789abcdef'
AUTH_ACCESS_TTL=900
AUTH_REFRESH_TTL=2592000
# ключ шифрования содержимого заявок до вскрытия
ENCRYPTION_KEY='test-encryption-key-0123456789abcdef0123456789abcdef'
###< security ###
###> mail (тесты: без SMTP; письма перехватывает MessageLoggerListener) ###
MAILER_DSN=null://null
MAILER_FROM=no-reply@tender-platform.local
# в тестах транспорт emails переопределён на in-memory (when@test)
MESSENGER_EMAILS_DSN=amqp://tender:tender@rabbitmq:5672/%2Ftender
###< mail ###
###> email verification ###
EMAIL_VERIFY_TTL=3600
EMAIL_VERIFY_URL_TEMPLATE=https://app.tender-platform.local/verify-email?token=%s
###< email verification ###

###> user invite ###
INVITE_URL_TEMPLATE=https://app.tender-platform.local/invite
###< user invite ###
###> idempotency ###
IDEMPOTENCY_TTL=3600
###< idempotency ###

###> outbox retention (docs/db-query-audit.md, п. 4) ###
# Окно хранения ОПУБЛИКОВАННЫХ outbox-событий (дни). Старше — удаляет
# `outbox:cleanup` (планировщик). pending не трогается ни при каком сроке.
OUTBOX_RETENTION_DAYS=7
###< outbox retention ###
###> auction recovery ###
AUCTION_HEARTBEAT_TIMEOUT=300
###< auction recovery ###

###> analytics (снапшоты счётчиков; периодичность из compose dev) ###
# Ротация Redis-ключей счётчиков (src/Analytics/Command/CounterSnapshotCommand).
COUNTER_SNAPSHOT_INTERVAL=300
###< analytics ###
###> webhooks ###
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_DELIVERY_TIMEOUT=10
###< webhooks ###
###> notifications ###
NOTIFICATION_DIGEST_INTERVAL=60
###< notifications ###
###> mercure (тесты: discovery-токен и publish-фабрика, без реального hub) ###
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3008/.well-known/mercure
MERCURE_PUBLISH_URL=http://mercure/.well-known/mercure
MERCURE_JWT_SECRET_PUBLISH='test-publish-secret-0123456789abcdef0123456789abcdef0123456789abcdef'
MERCURE_JWT_SECRET_SUBSCRIBE='test-subscribe-secret-0123456789abcdef0123456789abcdef0123456789abcdef'
MERCURE_SUBSCRIBE_TTL=3600
###< mercure ###

###> ru-state-procurement plugin ###
# В тестах правила РФ активны по умолчанию (проверка wiring + протоколов).
PROCUREMENT_PLUGIN_ENABLED=1
###< ru-state-procurement plugin ###

###> storage (тесты: локальный диск, каталог var/files под проектным корнем) ###
FILES_LOCAL_DIR=var/files
# Драйвер хранения файлов (в dev задаётся compose: FILES_STORAGE=local;
# в CI compose-env не проходит — декларируем тестовое значение здесь).
FILES_STORAGE=local
# Максимальный размер файла документа (байт; FR-1.1.5, 20 МБ)
DOCUMENT_MAX_FILE_BYTES=20971520
###< storage ###

###> password reset (FR-1.5.6) ###
PASSWORD_RESET_TTL=1800
PASSWORD_RESET_URL_TEMPLATE=https://app.tender-platform.local/reset-password?token=%s
###< password reset ###

###> framework (lock, routing, timezone) ###
LOCK_DSN=flock
DEFAULT_URI=http://localhost:8080
# Таймзона домена (в dev задаётся compose: DOMAIN_TIMEZONE=Europe/Moscow).
DOMAIN_TIMEZONE=Europe/Moscow
# Общий rate-limit api_global (RL-1; config/packages/rate_limiter.yaml
# использует %env(int:RATE_LIMIT_GLOBAL_PER_MIN)%). В dev задаётся compose
# (docker-compose.yml); в CI compose-env не проходит — декларируем здесь
# то же значение, что в .env (600). Для нагрузочных прогонов поднимается
# docker-compose.load.yml (APP_ENV=dev, тесты не затрагивает).
RATE_LIMIT_GLOBAL_PER_MIN=600
###< framework ###

###> observability ###
# Версия сборки для app_build_info{version} (деплой-аннотации на дашбордах)
APP_VERSION=dev
###< observability ###
