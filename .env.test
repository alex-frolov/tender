# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
###> security (тестовые) ###
AUTH_JWT_SECRET='test-secret-key-0123456789abcdef0123456789abcdef0123456789abcdef'
AUTH_ACCESS_TTL=900
AUTH_REFRESH_TTL=2592000
# ключ шифрования содержимого заявок до вскрытия
ENCRYPTION_KEY='test-encryption-key-0123456789abcdef0123456789abcdef'
###< security ###
###> mail (тесты: без SMTP; письма перехватывает MessageLoggerListener) ###
MAILER_DSN=null://null
MAILER_FROM=no-reply@tender-platform.local
# в тестах транспорт emails переопределён на in-memory (when@test)
MESSENGER_EMAILS_DSN=amqp://tender:tender@rabbitmq:5672/%2Ftender
###< mail ###
###> email verification ###
EMAIL_VERIFY_TTL=3600
EMAIL_VERIFY_URL_TEMPLATE=https://app.tender-platform.local/verify-email?token=%s
###< email verification ###

###> user invite ###
INVITE_URL_TEMPLATE=https://app.tender-platform.local/invite
###< user invite ###
###> idempotency ###
IDEMPOTENCY_TTL=3600
###< idempotency ###
###> auction recovery ###
AUCTION_HEARTBEAT_TIMEOUT=300
###< auction recovery ###
###> webhooks ###
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_DELIVERY_TIMEOUT=10
###< webhooks ###
###> notifications ###
NOTIFICATION_DIGEST_INTERVAL=60
###< notifications ###
###> mercure (тесты: discovery-токен и publish-фабрика, без реального hub) ###
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3008/.well-known/mercure
MERCURE_PUBLISH_URL=http://mercure/.well-known/mercure
MERCURE_JWT_SECRET_PUBLISH='test-publish-secret-0123456789abcdef0123456789abcdef0123456789abcdef'
MERCURE_JWT_SECRET_SUBSCRIBE='test-subscribe-secret-0123456789abcdef0123456789abcdef0123456789abcdef'
MERCURE_SUBSCRIBE_TTL=3600
###< mercure ###

###> ru-state-procurement plugin ###
# В тестах правила РФ активны по умолчанию (проверка wiring + протоколов).
PROCUREMENT_PLUGIN_ENABLED=1
###< ru-state-procurement plugin ###
