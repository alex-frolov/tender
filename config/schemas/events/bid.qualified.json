{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bid.qualified",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "tenant_id", "aggregate_type", "aggregate_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "bid.qualified" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "aggregate_type": { "const": "bid" },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["bid_id", "tender_id", "supplier_id", "decision", "reason"],
      "properties": {
        "bid_id": { "type": "string", "format": "uuid" },
        "tender_id": { "type": "string", "format": "uuid" },
        "supplier_id": { "type": "string", "format": "uuid" },
        "decision": { "type": "string", "enum": ["admit", "reject"] },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
