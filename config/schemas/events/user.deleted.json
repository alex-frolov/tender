{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "user.deleted",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "tenant_id", "aggregate_type", "aggregate_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "user.deleted" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "aggregate_type": { "const": "user" },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["user_id", "company_id"],
      "properties": {
        "user_id": { "type": "string", "format": "uuid" },
        "company_id": { "type": "string", "format": "uuid" },
        "actor": { "type": ["string", "null"], "format": "uuid" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
