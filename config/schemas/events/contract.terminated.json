{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contract.terminated",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "tenant_id", "aggregate_type", "aggregate_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "contract.terminated" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "aggregate_type": { "const": "contract" },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["contract_id", "terminated_at"],
      "properties": {
        "contract_id": { "type": "string", "format": "uuid" },
        "reason": { "type": ["string", "null"], "minLength": 1 },
        "terminated_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
