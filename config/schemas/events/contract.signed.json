{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contract.signed",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "tenant_id", "aggregate_type", "aggregate_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "contract.signed" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "aggregate_type": { "const": "contract" },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["contract_id", "signed_at"],
      "properties": {
        "contract_id": { "type": "string", "format": "uuid" },
        "number": { "type": "string" },
        "source": { "type": "string", "enum": ["tender", "external"] },
        "scope": { "type": "string", "enum": ["single_use", "multi_use"] },
        "customer_id": { "type": "string", "format": "uuid" },
        "supplier_id": { "type": "string", "format": "uuid" },
        "signed_at": { "type": "string", "format": "date-time" },
        "price_net_minor": { "type": ["integer", "null"], "minimum": 0 },
        "vat_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}