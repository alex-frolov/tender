{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tender.opened",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "tenant_id", "aggregate_type", "aggregate_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "tender.opened" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "aggregate_type": { "const": "tender" },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["tender_id", "number", "bids_count", "opened_at"],
      "properties": {
        "tender_id": { "type": "string", "format": "uuid" },
        "number": { "type": "string" },
        "bids_end": { "type": ["string", "null"], "format": "date-time" },
        "bids_count": { "type": "integer", "minimum": 0 },
        "opened_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
