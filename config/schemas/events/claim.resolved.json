{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claim.resolved",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "tenant_id", "aggregate_type", "aggregate_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "claim.resolved" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "aggregate_type": { "const": "claim" },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["claim_id", "contract_id", "outcome"],
      "properties": {
        "claim_id": { "type": "string", "format": "uuid" },
        "contract_id": { "type": "string", "format": "uuid" },
        "outcome": { "type": "string", "enum": ["rejected", "settled"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
