{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contract.pending_signature",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "tenant_id", "aggregate_type", "aggregate_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "contract.pending_signature" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "aggregate_type": { "const": "contract" },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["contract_id", "parties"],
      "properties": {
        "contract_id": { "type": "string", "format": "uuid" },
        "parties": {
          "type": "object",
          "required": ["customer", "supplier"],
          "properties": {
            "customer": { "type": "string", "format": "uuid" },
            "supplier": { "type": "string", "format": "uuid" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
