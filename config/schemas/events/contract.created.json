{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contract.created",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "tenant_id", "aggregate_type", "aggregate_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "contract.created" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "aggregate_type": { "const": "contract" },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["contract_id", "type_code", "source", "supplier_id", "customer_id", "scope"],
      "properties": {
        "contract_id": { "type": "string", "format": "uuid" },
        "type_code": { "type": "string" },
        "source": { "type": "string", "enum": ["tender", "external"] },
        "supplier_id": { "type": "string", "format": "uuid" },
        "customer_id": { "type": "string", "format": "uuid" },
        "scope": { "type": "string", "enum": ["single_use", "multi_use"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
