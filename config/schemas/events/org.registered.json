{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "org.registered",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "tenant_id", "aggregate_type", "aggregate_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "org.registered" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "aggregate_type": { "const": "company" },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["company_id", "name", "status"],
      "properties": {
        "company_id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "const": "pending" },
        "admin_user_id": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
