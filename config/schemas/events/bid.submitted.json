{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bid.submitted",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "tenant_id", "aggregate_type", "aggregate_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "bid.submitted" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "aggregate_type": { "const": "bid" },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["bid_id", "tender_id", "supplier_id"],
      "properties": {
        "bid_id": { "type": "string", "format": "uuid" },
        "tender_id": { "type": "string", "format": "uuid" },
        "lot_id": { "type": ["string", "null"], "format": "uuid" },
        "supplier_id": { "type": "string", "format": "uuid" },
        "has_price": { "type": "boolean" },
        "submitted_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}