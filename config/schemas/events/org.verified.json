{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "org.verified",
  "type": "object",
  "required": ["event_id", "event_type", "occurred_at", "tenant_id", "aggregate_type", "aggregate_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "org.verified" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "aggregate_type": { "const": "company" },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["company_id", "status"],
      "properties": {
        "company_id": { "type": "string", "format": "uuid" },
        "status": { "type": "string", "enum": ["active", "rejected", "suspended"] },
        "reason": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
